{
  "name": "tryoutflow-mobile",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "0.25.1",
    "react-native-get-random-values": "2.0.0",
    "react-native-purchases": "10.9.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-share": "12.3.1",
    "react-native-url-polyfill": "4.0.0",
    "react-native-webview": "13.16.1",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "main": "index.ts",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "typecheck": "tsc --noEmit",
    "bundle:ios": "react-native bundle --entry-file index.ts --platform ios --dev false --bundle-output ../../output/native-ci/ios/main.jsbundle --assets-dest ../../output/native-ci/ios",
    "bundle:android": "react-native bundle --entry-file index.ts --platform android --dev false --bundle-output ../../output/native-ci/android/index.android.bundle --assets-dest ../../output/native-ci/android"
  }
