{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "pixel": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "node": "24.12.0",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote",
        "gradleCommand": ":app:assembleRelease :app:bundleRelease -PreactNativeArchitectures=arm64-v8a",
        "applicationArchivePath": "android/app/build/outputs/apk/release/*.apk"
      },
      "buildArtifactPaths": ["android/app/build/outputs/bundle/release/*.aab"]
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6812832082"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
