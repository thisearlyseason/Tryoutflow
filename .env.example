NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_REGISTRATION_RATE_LIMIT_SECRET=
# Server-only HMAC key (at least 32 random characters) for privacy-safe shared abuse subjects.
ABUSE_PROTECTION_HMAC_SECRET=
# Cloudflare Turnstile site key is public; keep the secret key server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames returned by Turnstile Siteverify; no schemes or paths.
TURNSTILE_ALLOWED_HOSTNAMES=
# Matching P-256 JWK pair used only to sign/verify authoritative evaluation render snapshots.
# Keep the private JWK server-only; the public JWK is safe to expose to the browser bundle.
EVALUATION_SNAPSHOT_PROOF_PRIVATE_JWK=
NEXT_PUBLIC_EVALUATION_SNAPSHOT_PROOF_PUBLIC_JWK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_CLUB=
STRIPE_PRICE_ASSOCIATION=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
JOB_PROCESSOR_CRON_SECRET=
# Server-only opt-in for the clearly labeled deterministic demo adapter; no live transfer occurs.
ENABLE_MOCK_THE_SQUAD_PROVIDER=false

# Cross-platform billing v2. Leave unset until additive migrations and provider sandbox verification pass.
# Must match private.billing_configuration.environment. Never point sandbox purchases at production.
BILLING_ENVIRONMENT=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ORGANIZATION_MONTHLY=
STRIPE_PRICE_ORGANIZATION_ANNUAL=
STRIPE_PRICE_SINGLE_TRYOUT_PRO=
# Comma-separated previous price IDs, used only for existing purchase reconciliation.
STRIPE_LEGACY_PRICES_PRO_MONTHLY=
STRIPE_LEGACY_PRICES_PRO_ANNUAL=
STRIPE_LEGACY_PRICES_ORGANIZATION_MONTHLY=
STRIPE_LEGACY_PRICES_ORGANIZATION_ANNUAL=
STRIPE_LEGACY_PRICES_SINGLE_TRYOUT_PRO=
REVENUECAT_SECRET_KEY=
# V1-compatible API key from the same RevenueCat project, for CustomerInfo reads.
# The scoped V2 secret above cannot authenticate V1 requests.
REVENUECAT_V1_API_KEY=
# Configure RevenueCat Authorization header as: Bearer <this secret>
REVENUECAT_WEBHOOK_SECRET=
# Optional additional HMAC verification; required when configured here.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_APPLE_PRO_MONTHLY=
REVENUECAT_APPLE_PRO_ANNUAL=
REVENUECAT_APPLE_ORGANIZATION_MONTHLY=
REVENUECAT_APPLE_ORGANIZATION_ANNUAL=
REVENUECAT_APPLE_SINGLE_TRYOUT_PRO=
REVENUECAT_GOOGLE_PRO_MONTHLY=
REVENUECAT_GOOGLE_PRO_ANNUAL=
REVENUECAT_GOOGLE_ORGANIZATION_MONTHLY=
REVENUECAT_GOOGLE_ORGANIZATION_ANNUAL=
REVENUECAT_GOOGLE_SINGLE_TRYOUT_PRO=
# RevenueCat project ID; secret key needs customer subscriptions/purchases read and product read permissions.
REVENUECAT_PROJECT_ID=
# Optional documented Stripe access grace after the last paid invoice; default 0 preserves existing policy.
STRIPE_GRACE_PERIOD_HOURS=0

# New catalog endpoint has its own Stripe signing secret; keep the legacy endpoint secret unchanged.
STRIPE_BILLING_WEBHOOK_SECRET=

# Dedicated portal configuration for the new catalog; keep legacy portal products unchanged.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Marketing availability only; database billing_configuration.enabled controls payments.
BILLING_CHECKOUT_ENABLED=false
